#!/bin/bash
# s6 service: the bottown server, as the same git user as Forgejo so it can
# run `forgejo admin` and share /data.
mkdir -p "${BOTTOWN_DATA:-/data/bottown}"
chown git:git "${BOTTOWN_DATA:-/data/bottown}"
chmod 0700 "${BOTTOWN_DATA:-/data/bottown}"
exec su-exec git /usr/local/bin/bottown serve
